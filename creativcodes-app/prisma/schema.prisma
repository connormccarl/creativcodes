generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model NewsletterSignup {
  id        String   @id @default(cuid())
  email     String
  source    String   @default("website-footer-newsletter")
  createdAt DateTime @default(now())

  @@index([email])
  @@map("newsletter_signups")
}

model LeadSubmission {
  id             String   @id @default(cuid())
  name           String
  title          String
  company        String
  phone          String
  email          String
  engagementType String
  services       String[]
  source         String   @default("website-lead-modal")
  createdAt      DateTime @default(now())

  @@index([email])
  @@index([company])
  @@map("lead_submissions")
}
