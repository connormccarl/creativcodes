# Public production URL used for canonical links, Open Graph URLs, robots.txt, and sitemap.xml.
NEXT_PUBLIC_SITE_URL=https://www.creativcodes.com

# Google Analytics 4 measurement ID. Leave blank to disable analytics scripts.
# Example: G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# PostgreSQL connection string used by Prisma.
# Example: postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public
DATABASE_URL=
